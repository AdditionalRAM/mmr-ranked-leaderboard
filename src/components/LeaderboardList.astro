const leaderboard = await getLeaderboardData();
---

<div class="leaderboard-container">
  {leaderboard.length === 0 ? (
    <p class="error">Failed to load leaderboard data</p>
  ) : (
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Player</th>
          <th>ELO</th>
          <th>Rank</th>
          <th>PB</th>
        </tr>
      </thead>
      <tbody>
        {leaderboard.map((player, index) => (
          <LeaderboardElement player={player} position={index + 1} />
        ))}
      </tbody>
    </table>
  )}
</div>