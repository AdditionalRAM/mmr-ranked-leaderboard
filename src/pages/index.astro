---
export const prerender = false;

import LeaderboardList from '../components/LeaderboardList.astro';
import Layout from '../layouts/Layout.astro';

import logoImg from "../assets/macmasterrace-logo.png";
---

<Layout>
	<header class="site-header">
		<div class="logo-container">
			<img src={logoImg.src} alt="Mac Master Race" class="main-logo" />
		</div>
		<p class="subtitle">Maccord Leaderboard - MCSR Ranked</p>
		<p class="minitext"><a href="https://discord.gg/sczfsdE39W" target="_blank">Join the Maccord</a></p>
	</header>

	<main class="content-container">
		<LeaderboardList />
	</main>

	<footer>
		<p class="footertext">Leaderboard refreshes every 120 seconds</p>
		<p class="footertext">This is a leaderboard for the MCSR Maccord community, and does not include exclusively or the entirety of Mac players.</p>
		<p class="footertext">DM me your MCSR Ranked username on Discord in order to be added (must be in the Maccord!)</p>
		<p class="footertext">Made by <a href="https://additionalram.com" target="_blank">AdditionalRAM</a></p>

	</footer>
</Layout>

<style lang="scss">
	.logo-container{
		.main-logo{
			width: 450px;
			max-width: 100vw;
			margin-top: 3vh;
			image-rendering: pixelated;
		}
		
	}

	.subtitle{
		margin: 0;
		padding: 0;
	}

	.minitext{
		margin: 0;
		padding: 0;
		font-size: 0.7em;
		a{
			text-decoration: none;
			color: #dba213;
       		transition: 0.2s color cubic-bezier(0.175, 0.885, 0.32, 1.275);

			&:hover{
				color: #eaee57;
			}
		}
	}

	footer{
		.footertext{
			padding: 0;
			margin: 0;
			padding-bottom: 1vh;
			font-size: 0.7em;
			a{
				text-decoration: none;
				color: #00ff41;
				
			}
		}
	}
</style>